# ---------------------------------------------------------------------------
# Reference list of environment variables. This file is NOT auto-loaded by the
# proxy -- export/set the ones you need, or copy to a local .env of your own.
# NEVER put a real userToken in this file.
# ---------------------------------------------------------------------------

# --- sign-in ---
DEEPSEEK_TOKEN=
DEEPSEEK_DEVICE_ID=
DEEPSEEK_BASE=https://chat.deepseek.com
DEEPSEEK_TOKEN_FILE=
DEEPSEEK_TOKEN_REFRESH_COOLDOWN=60

# --- local server ---
DEEPSEEK_HOST=127.0.0.1
DEEPSEEK_PORT=18088
DEEPSEEK_ACCESS_LOG=0

# --- upstream pacing ---
DEEPSEEK_MAX_CONCURRENCY=2
DEEPSEEK_MIN_INTERVAL_MS=800
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_BACKOFF_BASE_MS=600
DEEPSEEK_BACKOFF_MAX_MS=8000
DEEPSEEK_BACKOFF_JITTER=0.25

# --- turn behaviour ---
DEEPSEEK_MAX_CONTINUES=20
DEEPSEEK_INCLUDE_THINKING=0
DEEPSEEK_THINKING=0
DEEPSEEK_SEARCH=0

# --- PoW accelerator (optional) ---
# DEEPSEEK_POW_NODE=C:\path\to\node.exe
# DEEPSEEK_POW_JS=C:\path\to\_pow_node.js

# --- client impersonation ---
DEEPSEEK_CLIENT_VERSION=2.7.1
DEEPSEEK_CLIENT_LOCALE=zh_CN
DEEPSEEK_CLIENT_PLATFORM=web
DEEPSEEK_BUNDLE_ID=com.deepseek.chat
DEEPSEEK_ORIGIN=https://chat.deepseek.com
DEEPSEEK_REFERER=https://chat.deepseek.com/
DEEPSEEK_TIMEZONE_OFFSET=28800
